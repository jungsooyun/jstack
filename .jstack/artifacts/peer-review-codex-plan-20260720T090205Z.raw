     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
     5	cd "$ROOT"
     6	
     7	fail() {
     8	  echo "[FAIL] $*" >&2
     9	  exit 1
    10	}
    11	
    12	json_name() {
    13	  python3 - "$1" <<'PY'
    14	import json, sys
    15	with open(sys.argv[1], encoding="utf-8") as f:
    16	    print(json.load(f).get("name", ""))
    17	PY
    18	}
