    20	# Escape string for JSON embedding using bash parameter substitution.
    21	# Each ${s//old/new} is a single C-level pass - orders of magnitude
    22	# faster than the character-by-character loop this replaces.
    23	escape_for_json() {
    24	    local s="$1"
